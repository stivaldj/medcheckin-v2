# Copie para .env e preencha. NUNCA commite .env. Sem valor default para segredos.
POSTGRES_USER=medcheckin
POSTGRES_PASSWORD=
POSTGRES_DB=medcheckin
POSTGRES_PORT=5434
# Usada por core, web e scheduler. Ex.: postgres://medcheckin:<senha>@localhost:5432/medcheckin
DATABASE_URL=
# E3+: auth e e-mail (nomes reservados; dev usa Mailpit)
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# E5+: Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
