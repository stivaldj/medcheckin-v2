# Copie para .env e preencha. NUNCA commite .env. Sem valor default para segredos.
POSTGRES_USER=medcheckin
POSTGRES_PASSWORD=
POSTGRES_DB=medcheckin
POSTGRES_PORT=5434
# Usada por core, web e scheduler. Ex.: postgres://medcheckin:<senha>@localhost:5432/medcheckin
DATABASE_URL=
# Banco dos testes (separado do dev). Crie com: docker compose exec db createdb -U medcheckin medcheckin_test
DATABASE_URL_TEST=
# URL pública do app (links do e-mail). Dev: http://localhost:3000
APP_BASE_URL=
# E-mail (link mágico). Dev: Mailpit do compose (SMTP 1025, UI http://localhost:8025). Sem SMTP o envio falha (não finge).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
# Só fora de produção: MAIL_TRANSPORT=fake usa mailer em memória (testes)
MAIL_TRANSPORT=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Web Push (gere com: node -e "console.log(require('web-push').generateVAPIDKeys())" dentro de packages/core)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaclinica.example
# Scheduler
SCHEDULER_INTERVAL_MS=60000
# Opcionais (têm default): porta do /health do scheduler e verbosidade do log
# SCHEDULER_PORT=3001            LOG_LEVEL=info
# Produção (docker-compose.prod.yml, arquivo .env.prod — nunca commitar)
# DOMAIN=app.clinica.com.br      CADDY_TLS_DIRECTIVE=            (localhost: "tls internal")
# BACKUP_PASSPHRASE=             BACKUP_KEEP_DAYS=14  BACKUP_CRON="15 3 * * *"  BACKUP_RCLONE_REMOTE=
# HEALTH_REQUIRE_SCHEDULER=1     APP_VERSION=<git sha>
# Uptime (scripts/uptime-check.mjs): HEALTH_URL= ALERT_EMAIL= HEALTH_TIMEOUT_MS=10000
#   Prove o alerta ANTES de precisar dele: node scripts/uptime-check.mjs --selftest
