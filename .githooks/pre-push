#!/bin/sh
# Verificação antes do push.
#
# O CI do GitHub não roda neste repositório (sem cota de Actions), então este hook é a única
# barreira entre um erro local e o `main`: roda o mesmo `npm run check` que o CI rodaria —
# lint, prettier, typecheck e as suítes de teste contra o Postgres.
#
# Pular numa emergência: git push --no-verify   (e rode `npm run check` logo depois)

set -e
cd "$(git rev-parse --show-toplevel)"

# Push que só apaga branches remotas não leva código: não há o que verificar.
has_code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) has_code=1 ;;
  esac
done
[ "$has_code" = 0 ] && exit 0

err="$(mktemp)"
trap 'rm -f "$err"' EXIT

# Os testes precisam do Postgres. Sem ele o check falharia com dezenas de "connection refused"
# que escondem a causa — melhor dizer logo o que fazer.
if ! node --env-file-if-exists=.env -e '
  const url = process.env.DATABASE_URL_TEST || process.env.DATABASE_URL;
  if (!url) { console.error("DATABASE_URL_TEST não definida no .env"); process.exit(1); }
  const { Client } = require("pg");
  const c = new Client({ connectionString: url, connectionTimeoutMillis: 3000 });
  c.connect().then(() => c.end()).catch((e) => {
    // ECONNREFUSED chega como AggregateError de mensagem vazia: o código é o que informa.
    console.error(e.code || e.errors?.[0]?.code || e.message || "sem conexão");
    process.exit(1);
  });
' 2>"$err"; then
  echo ""
  echo "pre-push: o Postgres dos testes não respondeu ($(cat "$err"))."
  echo "Suba o banco e tente de novo:"
  echo ""
  echo "  docker compose --env-file .env up -d db mailpit"
  echo ""
  exit 1
fi

echo "pre-push: npm run check (lint, prettier, typecheck, testes)…"
if ! npm run check --silent; then
  echo ""
  echo "pre-push: npm run check falhou — push cancelado. Corrija e tente de novo."
  exit 1
fi
